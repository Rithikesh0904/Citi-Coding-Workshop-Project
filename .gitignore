backend/*/psycopg*
backend/*/pymongo*
backend/*/bson*
backend/*/gridfs*
backend/*/*.dist-info
backend/*/*.libs
backend/*/bin/

# Build output
frontend/dist/
frontend/node_modules/
infra/builds/
infra/.terraform/
infra/*.tfstate*
infra/*.tfplan

# Python
__pycache__/
*.pyc
.pytest_cache/
.coverage
htmlcov/

# Editor and OS
.vscode/
.idea/
.DS_Store
*.swp

# LocalStack pip marker
backend/*/.pip_installed
